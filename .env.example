# Общие переменные PostgreSQL для docker-compose.db.yml, docker-compose.bot.yml
# и docker-compose.api.yml (без реальных секретов).
DB_USER=USER
DB_PASSWORD=PASS
# Нужна только сервису pgadmin из docker-compose.db.yml.
TG_EMAIL=admin@example.com

# Сервис tg_bot: docker-compose.bot.yml. Env побеждает config.ini.
TG_TOKEN=replace-with-bot-token
# Whitelist chat_id через запятую. Пусто — бот никому не отвечает.
TG_ALLOWED_CHAT_IDS=123456789

# Сервис api: docker-compose.api.yml. TG_TOKEN и TG_ALLOWED_CHAT_IDS ему не нужны.
# JWT, один админ.
# Внешний порт API на хосте (внутри контейнера всегда 8000).
API_HOST_PORT=8000
API_NETWORK_ALIAS=katefit-api
API_IMAGE=katefit-api:latest
API_USER=admin
API_PASSWORD=replace-with-api-password
API_JWT_SECRET=replace-with-jwt-secret

# Gelios: API-ключ Twenty хранится только на сервере.
CRM_ENABLED=0
CRM_BASE_URL=https://crm-stage.example.com
# Секрет сервера: не передавать во фронтенд.
CRM_API_KEY=

# Подключение tg_bot и api к Postgres (БД деплоится отдельно).
# Обязательно: IP/hostname, reachable из контейнера соответствующего сервиса.
# Локально с хоста: localhost. В Dokploy: hostname/IP вашего Postgres.
SQL_DATABASE=Kate_fitness
SQL_HOST=localhost
SQL_PORT=5432

# Тесты: отдельная БД на порту 5433 (контейнер pg_db_test).
# Запрещено: имя Kate_fitness и порт 5432 (прод).
# Pytest сам .env не подхватывает — экспортируйте DATABASE_URL или передайте в команде.
DATABASE_URL=postgresql://USER:PASS@localhost:5433/Kate_fitness_test

# MCP PostgreSQL: пароль не попадает в Git. Скрипт mcp/setup_postgres_mcp.sh
# перенесёт его в системную связку ключей и создаст профиль только для чтения.
MCP_DB_USER=USER
MCP_DB_PASSWORD=PASS
MCP_DB_HOST=localhost
MCP_DB_PORT=5432
MCP_DB_DATABASE=Kate_fitness

# Сервис ui: отдельный Dokploy compose docker-compose.ui.yml.
# Обязательная переменная сервиса ui: адрес API, доступный из контейнера UI.
# Без /api/v1 и без завершающего /. Домен UI назначается в Dokploy на порт 80.
UI_HOST_PORT=8080
UI_API_ORIGIN=https://api.example.com
# Если UI и API развёрнуты на одном сервере в общей dokploy-network,
# API сам публикует alias katefit-api (см. docker-compose.api.yml).
# Тогда внешний DNS не нужен:
# UI_API_ORIGIN=http://katefit-api:8000
# API_USER / API_PASSWORD / API_JWT_SECRET задаются у API, а не у UI.

# Локальный dev-сервер UI (npm run dev из каталога ui).
# UI_API_ORIGIN=http://127.0.0.1:8000
# UI_PORT=5173

# Постоянная плашка тестового стенда: stage; без плашки: production.
UI_ENVIRONMENT=production
