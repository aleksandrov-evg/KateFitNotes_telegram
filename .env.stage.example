# Шаблон для двух отдельных stage-проектов Dokploy.
# API: docker-compose.api.stage.yml; UI: docker-compose.ui.stage.yml.
# В проект UI достаточно передать UI_HOST_PORT и UI_API_ORIGIN.
API_HOST_PORT=8001
UI_HOST_PORT=8081
UI_API_ORIGIN=http://katefit-api-stage:8000

# Отдельная stage-БД, доступная из контейнера API; создаётся отдельно.
SQL_HOST=replace-with-stage-postgres-host
SQL_PORT=5432
SQL_DATABASE=Kate_fitness_stage
DB_USER=replace-with-stage-db-user
DB_PASSWORD=replace-with-stage-db-password

# Собственные учётные данные и JWT-секрет stage.
API_USER=admin-stage
API_PASSWORD=replace-with-stage-api-password
API_JWT_SECRET=replace-with-stage-jwt-secret

CRM_ENABLED=0
CRM_BASE_URL=
CRM_API_KEY=
